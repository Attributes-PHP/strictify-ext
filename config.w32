// vim:ft=javascript
//
// Windows build configuration for the attributes-strictify extension. Mirrors
// config.m4, which drives the Linux and macOS builds — keep the source list
// below in sync with PHP_NEW_EXTENSION there when adding a file.
//
// PCRE headers (ext/pcre/php_pcre.h -> pcre2.h) come from the PHP build itself,
// so no extra library is required here.

ARG_ENABLE("attributes-strictify", "Enable attributes-strictify support", "no");

if (PHP_ATTRIBUTES_STRICTIFY != "no") {
	// PHP_VERSION and PHP_MINOR_VERSION are numeric tokens (8 and 2), not a
	// version string: comparing against "8.2" coerces to 8 < 8.2 and always
	// fires.
	if (PHP_VERSION < 8 || (PHP_VERSION == 8 && PHP_MINOR_VERSION < 2)) {
		ERROR("attributes-strictify requires PHP 8.2 or later");
	}

	// phpize-driven builds (PIE, PECL, php-windows-builder) pass a plain
	// --enable-attributes-strictify. confutils then leaves
	// PHP_ATTRIBUTES_STRICTIFY_SHARED unset, so EXTENSION() would link the
	// module statically and no php_attributes_strictify.dll would appear.
	// A plain enable means shared; =static still builds statically.
	if (PHP_ATTRIBUTES_STRICTIFY == "yes") {
		PHP_ATTRIBUTES_STRICTIFY_SHARED = true;
	}

	if (PHP_ATTRIBUTES_STRICTIFY_SHARED) {
		AC_DEFINE('ATTRIBUTES_STRICTIFY_SHARED', 1, 'Define to 1 if attributes-strictify is built as a shared module.');
	}

	// config.m4 declares PHP_ADD_EXTENSION_DEP(attributes_strictify, date): the
	// DateTime coercion calls date_create_from_format(). There is no Windows
	// counterpart on purpose — ext/date is always compiled in, and
	// php-windows-builder reads ADD_EXTENSION_DEP as "build this module too",
	// which would send it looking for a separate `date` extension.

	EXTENSION("attributes_strictify", "strictify.c \
		src/as_validate_function.c src/as_compiled_model.c src/as_call_function.c \
		src/as_base_model.c src/as_exception.c src/as_model_configs.c src/as_error_translator.c \
		src/as_type.c src/helpers/as_wrappers.c src/helpers/as_options.c src/helpers/as_string.c \
		src/helpers/as_error_messages.c src/fields/as_constraint.c \
		src/fields/as_config_aware_constraint.c src/fields/as_field.c src/fields/as_alias.c \
		src/fields/as_error_message.c src/fields/as_sequence.c src/fields/as_union.c \
		src/fields/as_intersection.c src/fields/as_dict.c src/fields/as_sensitive.c \
		src/fields/constraints/as_alpha_dash.c src/fields/constraints/as_ascii.c \
		src/fields/constraints/as_between.c src/fields/constraints/as_contains.c \
		src/fields/constraints/as_datetime.c src/fields/constraints/as_ends_with.c \
		src/fields/constraints/as_in.c src/fields/constraints/as_max.c \
		src/fields/constraints/as_min.c src/fields/constraints/as_multiple_of.c \
		src/fields/constraints/as_regex.c src/fields/constraints/as_size.c \
		src/fields/constraints/as_starts_with.c src/fields/constraints/as_ulid.c \
		src/fields/constraints/as_uuid.c src/fields/constraints/as_email.c \
		src/fields/constraints/as_url.c src/fields/constraints/as_domain.c \
		src/fields/constraints/as_ip.c src/fields/constraints/as_iban.c \
		src/fields/constraints/as_isbn.c src/fields/constraints/as_credit_card.c \
		src/fields/constraints/as_version.c \
		src/fields/constraints/as_mac_address.c src/fields/constraints/as_alnum.c \
		src/fields/constraints/as_alpha.c src/fields/constraints/as_digit.c \
		src/fields/constraints/as_xdigit.c \
		src/fields/constraints/as_slug.c \
		src/fields/constraints/as_base64.c src/fields/constraints/as_json.c \
		src/fields/constraints/as_hex_rgb_color.c \
		src/fields/constraints/as_even.c src/fields/constraints/as_odd.c \
		src/fields/constraints/as_positive.c src/fields/constraints/as_negative.c src/fields/constraints/as_prime_number.c \
		src/fields/constraints/as_contains_any.c src/validators/as_typehint_validator.c \
		src/validators/as_array_typehint_validator.c");
}
