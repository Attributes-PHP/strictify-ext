{
    "name": "attributes-php/strictify-ext",
    "type": "php-ext",
    "description": "Pydantic-inspired PHP library for validating data via type hints at lightning speed \u26a1\ufe0f",
    "keywords": [
        "validation",
        "fast",
        "attributes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Attributes\\Strictify\\Tests\\": "tests/Integration/",
            "Attributes\\Strictify\\Tests\\Benchmark\\": "tests/Benchmark/",
            "Attributes\\Strictify\\Tests\\Docs\\": "tests/Docs/"
        },
        "classmap": [
            "tests/Integration/Models/"
        ]
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "carthage-software/mago": "^1.50.0",
        "phpbench/phpbench": "^1.7",
        "symfony/validator": "^7.4 || ^8.0",
        "respect/validation": "^2.5 || ^3.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/translation": "^12.0 || ^13.0"
    },
    "php-ext": {
        "extension-name": "attributes-strictify",
        "configure-options": [
            {
                "name": "enable-attributes-strictify"
            }
        ]
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.37"
        }
    }
}
